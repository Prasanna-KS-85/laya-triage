<mxCell id="lg7" value="Frozen contract / gate" style="rounded=0;html=1;fillColor=#F8CECC;strokeColor=#B85450;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1105" y="92" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="lg_e1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#444444;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1320" y="102" as="sourcePoint"/><mxPoint x="1360" y="102" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lg_e2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;dashPattern=6 4;strokeColor=#888888;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1535" y="102" as="sourcePoint"/><mxPoint x="1575" y="102" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lg_t1" value="data / control flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1366" y="92" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="lg_t2" value="reference / artifact" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1581" y="92" width="150" height="20" as="geometry"/></mxCell>
<mxCell id="bandA" value="A · BUILD TIME — from raw issues to a frozen, calibrated, versioned model (done once per model version)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=#FCFCFC;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="135" width="1720" height="735" as="geometry"/></mxCell>
<mxCell id="ln1" value="STEP 1 · DATA PREPARATION (Local Mac)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF4FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="320" height="660" as="geometry"/></mxCell>
<mxCell id="ln2" value="STEP 2 · FINE-TUNING (Kaggle, two T4 GPUs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFF5EB;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="380" y="185" width="320" height="660" as="geometry"/></mxCell>
<mxCell id="ln3" value="STEP 3 · MODEL REGISTRY (Hugging Face Hub)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFCEB;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="720" y="185" width="320" height="660" as="geometry"/></mxCell>
<mxCell id="ln4" value="STEP 4 · CALIBRATE · GATE · EVALUATE (Local Mac, CPU)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#EEF4FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1060" y="185" width="320" height="660" as="geometry"/></mxCell>
<mxCell id="ln5" value="STEP 5 · RELEASE (GitHub repository)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#F7F7F7;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1400" y="185" width="320" height="660" as="geometry"/></mxCell>
<mxCell id="D1" value="&lt;b&gt;NLBSE'24 dataset (external)&lt;/b&gt;&lt;br&gt;1,500 train + 1,500 test issues · 5 repos · bug / feature / question · SHA-256 pinned" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="50" y="235" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="D2" value="&lt;b&gt;fetch_data.py → build_dataset.py&lt;/b&gt;&lt;br&gt;verify hashes · drop 4 train rows duplicated in test · stratified 20% validation split (seed 42) · synthetic IDs + content hashes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="345" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="D3" value="&lt;b&gt;preprocess() — one shared cleaning path&lt;/b&gt;&lt;br&gt;frozen: used by training, evaluation and runtime" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="D4" value="&lt;b&gt;train 1,196 · val 300 · test 1,500&lt;/b&gt;&lt;br&gt;manifests with IDs and content hashes · raw data is never committed (dataset license unspecified)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="D5" value="&lt;b&gt;Frozen question (questions.py)&lt;/b&gt;&lt;br&gt;one choice question: bug / feature / question — wording and option order are part of the model contract" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="K1" value="&lt;b&gt;Private Kaggle dataset&lt;/b&gt;&lt;br&gt;train + val only; the test split never leaves the Mac" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="390" y="235" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="K2" value="&lt;b&gt;Pinned environment&lt;/b&gt;&lt;br&gt;laya 0.3.23 · transformers 5.18.0 · base revision 55cf4c4e (asserted in the notebook)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="390" y="345" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="K3" value="&lt;b&gt;make_items.py&lt;/b&gt;&lt;br&gt;pack [CLS] question [SEP] [MASK] options [SEP] state at 1024/256 tokens; items hash must equal the local one (parity check)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="390" y="455" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="K4" value="&lt;b&gt;RLCD fine-tuning · two T4 GPUs · fp16&lt;/b&gt;&lt;br&gt;proper-scoring-rule RL reward + soft cross-entropy · 4 epochs · 68 optimizer steps · seed 42 · then fits a temperature on 119 held-out items" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="390" y="575" width="300" height="125" as="geometry"/></mxCell>
<mxCell id="K5" value="&lt;b&gt;Push to Hugging Face&lt;/b&gt;&lt;br&gt;upload_folder to the existing repo (never create_repo) · fine-grained write token kept in Kaggle Secrets" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="390" y="720" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="H1" value="&lt;b&gt;Base: convaiinnovations/laya (public)&lt;/b&gt;&lt;br&gt;ModernBERT-large encoder + decision head, ~421M parameters · downloaded anonymously at a pinned revision" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="235" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="H2" value="&lt;b&gt;R1 · a704b3ea (our fine-tune)&lt;/b&gt;&lt;br&gt;weights + notebook-fitted temperature 4.02" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="355" width="300" height="85" as="geometry"/></mxCell>
<mxCell id="H3" value="&lt;b&gt;R1b · 76ece1fb (shipped revision)&lt;/b&gt;&lt;br&gt;identical weights; temperature refit on validation to 2.70 — a config-only commit; the Action pins this SHA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="H4" value="&lt;b&gt;Public model repo + model card&lt;/b&gt;&lt;br&gt;anonymous download at runtime — no token needed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="590" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="E1" value="&lt;b&gt;run_eval.py — CPU, full precision, offline&lt;/b&gt;&lt;br&gt;downloads the pinned revision (read-only); asserts config, question, input hash" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1070" y="235" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="E2" value="&lt;b&gt;Temperature scaling on validation&lt;/b&gt;&lt;br&gt;weights untouched; only the config temperature changes (4.02 → 2.70)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1070" y="350" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="E3" value="&lt;b&gt;Per-label thresholds (spec rule)&lt;/b&gt;&lt;br&gt;bootstrap precision lower bound ≥ 0.90 on validation · bug 0.6033 · feature never · question never" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1070" y="460" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="E4" value="&lt;b&gt;Pre-test freeze&lt;/b&gt;&lt;br&gt;config + test guard + pre-declared protocol committed (tag phase3-prefreeze)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1070" y="585" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="E5" value="&lt;b&gt;Test split scored exactly once&lt;/b&gt;&lt;br&gt;vs majority class · TF-IDF + logistic regression · zero-shot Laya · published NLBSE'24 (SetFit, RoBERTa, fastText) → results/, figures, model card" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1070" y="695" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="G1" value="&lt;b&gt;PROJECT_SPEC.md&lt;/b&gt;&lt;br&gt;single source of truth: requirements, decisions, phase gates, changelog" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="235" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="G4" value="&lt;b&gt;config/triage.default.yml&lt;/b&gt;&lt;br&gt;model revision SHA · thresholds · labels · dry-run by default" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1410" y="350" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="G2" value="&lt;b&gt;laya_triage package + action.yml&lt;/b&gt;&lt;br&gt;pure, unit-tested modules (config, event_loader, preprocess, classifier, policy, github_client, reporter) · composite Action · Linux dependency lock from CI · CI runs without model weights" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="465" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="G6" value="&lt;b&gt;Release and docs&lt;/b&gt;&lt;br&gt;README and model card generated from results/ · tags v1.0.0-rc1 → v1.0.0 · consumers pin the full commit SHA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="675" width="300" height="150" as="geometry"/></mxCell>
