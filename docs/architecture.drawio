<mxCell id="bandB" value="B · RUN TIME — what happens when someone opens an issue (GitHub-hosted runner, CPU only, no paid APIs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=#FCFCFC;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1720" height="735" as="geometry"/></mxCell>
<mxCell id="R1" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;issues: opened · workflow_dispatch (backfill) · schedule (cache warm-up)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="210" height="105" as="geometry"/></mxCell>
<mxCell id="R2" value="&lt;b&gt;Consumer workflow&lt;/b&gt;&lt;br&gt;uses: laya-triage@commit-SHA · permissions: issues write, contents read" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="312" y="965" width="280" height="105" as="geometry"/></mxCell>
<mxCell id="R3" value="&lt;b&gt;Composite Action: environment&lt;/b&gt;&lt;br&gt;Linux guard → Python → venv cache or pinned install (CPU-only torch) → model cache or anonymous download" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="654" y="965" width="390" height="105" as="geometry"/></mxCell>
<mxCell id="R4" value="&lt;b&gt;Hugging Face (public)&lt;/b&gt;&lt;br&gt;pinned revision, about 0.85 GB, fetched only on a cold cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1106" y="965" width="250" height="105" as="geometry"/></mxCell>
<mxCell id="R5" value="&lt;b&gt;GitHub Actions cache&lt;/b&gt;&lt;br&gt;venv + model snapshot · issue runs restore, schedule / dispatch runs save" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1418" y="965" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="ln_py" value="python -m laya_triage (package src/laya_triage) — one run per event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#F0F8EE;strokeColor=#82B366;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1680" height="250" as="geometry"/></mxCell>
<mxCell id="P1" value="&lt;b&gt;event_loader&lt;/b&gt;&lt;br&gt;reads the event JSON from the runner (never a shell line); skips PRs, bots, labelled or escalated issues" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="50" y="1150" width="215" height="140" as="geometry"/></mxCell>
<mxCell id="P2" value="&lt;b&gt;preprocess()&lt;/b&gt;&lt;br&gt;the same cleaning code used in training → state {title, body}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="290" y="1150" width="195" height="140" as="geometry"/></mxCell>
<mxCell id="P3" value="&lt;b&gt;Classifier (Laya)&lt;/b&gt;&lt;br&gt;CPU, full precision, pinned revision · one forward pass → a probability for each label" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="510" y="1150" width="225" height="140" as="geometry"/></mxCell>
<mxCell id="P4" value="&lt;b&gt;confidence ≥ threshold?&lt;/b&gt;&lt;br&gt;per label, from config" style="rhombus;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="760" y="1130" width="210" height="180" as="geometry"/></mxCell>
<mxCell id="P5a" value="&lt;b&gt;APPLY label&lt;/b&gt;&lt;br&gt;type: bug (the only label with a threshold)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1030" y="1145" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="P5b" value="&lt;b&gt;ESCALATE&lt;/b&gt;&lt;br&gt;triage: needs-human + optional fixed-text comment (top two guesses)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1030" y="1245" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="P6" value="&lt;b&gt;github_client&lt;/b&gt;&lt;br&gt;REST add-label / comment, retries with backoff, token only from env; dry-run writes nothing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1255" y="1150" width="210" height="140" as="geometry"/></mxCell>
<mxCell id="P7" value="&lt;b&gt;reporter + exit code&lt;/b&gt;&lt;br&gt;job-summary table and JSONL artifact (no issue text); soft failures exit 0, misconfiguration exits 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1490" y="1150" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="C1" value="INSIDE LAYA — how one forward pass answers the question" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1100" height="230" as="geometry"/></mxCell>
<mxCell id="L1" value="&lt;b&gt;State&lt;/b&gt;&lt;br&gt;the cleaned title and body" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="60" y="1430" width="170" height="140" as="geometry"/></mxCell>
<mxCell id="L2" value="&lt;b&gt;Sequence packing&lt;/b&gt;&lt;br&gt;[CLS] question [SEP] [MASK] bug [MASK] feature [MASK] question [SEP] state — the options are inputs, not an output layer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="262" y="1430" width="250" height="140" as="geometry"/></mxCell>
<mxCell id="L3" value="&lt;b&gt;ModernBERT-large encoder&lt;/b&gt;&lt;br&gt;bidirectional: every token sees the state and all options" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="544" y="1430" width="190" height="140" as="geometry"/></mxCell>
<mxCell id="L4" value="&lt;b&gt;2-layer decision head&lt;/b&gt;&lt;br&gt;reads the hidden state at each [MASK] → one logit per option" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="766" y="1430" width="190" height="140" as="geometry"/></mxCell>
<mxCell id="L5" value="&lt;b&gt;softmax(logits / T)&lt;/b&gt;&lt;br&gt;T = 2.70 → probabilities; confidence = max" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="988" y="1430" width="140" height="140" as="geometry"/></mxCell>
<mxCell id="C2" value="&lt;b&gt;Why confidence-gated?&lt;/b&gt;&lt;br&gt;answer_confidence is the calibrated probability of the predicted label. The Action applies a label only when it clears that label's threshold fitted on validation data; everything else goes to a human. In v1.0 only bug qualifies: on test, 26.1% of issues are labelled at 87.5% precision — the 0.90 target was missed." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fontSize=13;fillColor=#FFF9E5;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="1380" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="C3" value="&lt;b&gt;Safety and reliability&lt;/b&gt;&lt;br&gt;• issue text is untrusted: it never reaches a shell&lt;br&gt;• least privilege: issues write, contents read&lt;br&gt;• comments contain fixed text only&lt;br&gt;• fail-soft: runtime errors exit 0&lt;br&gt;• default mode is dry-run&lt;br&gt;• actions pinned by SHA; dependency lock built on Linux CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;fontSize=13;fillColor=#F0F8EE;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1450" y="1380" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="e25" value="consumers run uses: laya-triage@SHA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G6" target="R2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="945"/><mxPoint x="452" y="945"/></Array></mxGeometry></mxCell>
<mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
