<mxCell id="lg5" value="GitHub Actions runner" style="rounded=0;html=1;fillColor=#D5E8D4;strokeColor=#82B366;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="64" width="20" height="20" as="geometry"/></mxCell>
