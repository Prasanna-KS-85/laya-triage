<mxCell id="title" value="Laya Triage — master architecture and workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1030" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="A fine-tuned Laya decision model, calibrated probabilities and a GitHub Action that labels an issue only when it is confident enough — and hands everything else to a human." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1030" height="50" as="geometry"/></mxCell>
