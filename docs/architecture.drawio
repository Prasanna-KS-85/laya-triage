<mxCell id="bandC" value="C · HOW IT WAS BUILT — spec-driven phases, frozen contracts, a pre-registered test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=1;fillColor=#FCFCFC;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1665" width="1720" height="300" as="geometry"/></mxCell>
<mxCell id="F0" value="&lt;b&gt;Phase 0 · Feasibility&lt;/b&gt;&lt;br&gt;model loads on CPU, zero-shot wording test, question frozen" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="F1" value="&lt;b&gt;Phase 1 · Dataset&lt;/b&gt;&lt;br&gt;fetch, clean, split, leakage checks, manifests" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="322" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="F2" value="&lt;b&gt;Phase 2 · Baselines&lt;/b&gt;&lt;br&gt;majority, TF-IDF, zero-shot Laya; published numbers copied" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="604" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="F3" value="&lt;b&gt;Phase 3 · Fine-tune and calibrate&lt;/b&gt;&lt;br&gt;Kaggle RLCD, temperature refit, thresholds, one test run" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="886" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="F4" value="&lt;b&gt;Phase 4 · GitHub Action&lt;/b&gt;&lt;br&gt;modules, action.yml, CI, sandbox repo, runner parity" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1168" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="F5" value="&lt;b&gt;Phase 5 · Ship&lt;/b&gt;&lt;br&gt;README from results, public repo, v1.0.0 release" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#E8EEF7;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1450" y="1715" width="270" height="95" as="geometry"/></mxCell>
<mxCell id="Z1" value="&lt;b&gt;Frozen contracts&lt;/b&gt;&lt;br&gt;change only via a spec edit + changelog + re-evaluation: question wording, preprocess(), split manifests, thresholds and model revision in config. The test split is scored once, after a pre-declared protocol." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="1830" width="545" height="110" as="geometry"/></mxCell>
<mxCell id="Z2" value="&lt;b&gt;Evidence trail&lt;/b&gt;&lt;br&gt;PROJECT_SPEC.md changelog · results/ (metrics JSON, figures) · phase tags phase0-complete … phase4-complete, v1.0.0-rc1 · the README and model card are generated from results/, so no number is typed by hand." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#EEEEEE;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="607" y="1830" width="545" height="110" as="geometry"/></mxCell>
<mxCell id="Z3" value="&lt;b&gt;Headline results (test, 1,500 issues, scored once)&lt;/b&gt;&lt;br&gt;cross-repo macro-F1 0.802 vs 0.766 TF-IDF and 0.611–0.626 zero-shot · ECE 0.045 (0.147 uncalibrated) · bug-only gating: 26.1% coverage at 87.5% precision (0.90 target missed) · runner: cold 1m26s, warm 44–56 s · per-issue p95 3.5 s on 2 vCPU (target not met)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1174" y="1830" width="545" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>