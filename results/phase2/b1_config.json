{
 "system": "B1",
 "text": "state.title + '\\n' + state.body (data/processed, PROJECT_SPEC.md \u00a78.4)",
 "fit_on": "data/processed/train.jsonl only",
 "vectorizer": {
  "class": "sklearn.feature_extraction.text.TfidfVectorizer",
  "ngram_range": [
   1,
   2
  ],
  "min_df": 2,
  "sublinear_tf": true
 },
 "classifier": {
  "class": "sklearn.linear_model.LogisticRegression",
  "C": 10,
  "class_weight": null,
  "random_state": 42,
  "max_iter": 10000
 },
 "other_parameters": "scikit-learn 1.9.1 defaults",
 "selection": {
  "split": "val",
  "metric": "cross-repo macro-F1",
  "ties": "smaller C, then smaller min_df, then sublinear_tf False",
  "grid": {
   "C": [
    0.3,
    1,
    3,
    10,
    30
   ],
   "min_df": [
    1,
    2
   ],
   "sublinear_tf": [
    false,
    true
   ]
  },
  "val_cross_repo_macro_f1": 0.7567245523019369
 },
 "versions": {
  "python": "3.11.17",
  "laya": "0.3.23",
  "torch": "2.14.1",
  "numpy": "2.4.6",
  "scikit-learn": "1.9.1",
  "scipy": "1.17.1",
  "joblib": "1.6.0",
  "threadpoolctl": "3.7.0"
 }
}
